// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum ActivityType {
  CREATED
  UPDATED
  MOVED
  ASSIGNED
  UNASSIGNED
  COMMENTED
  MENTIONED
  LABEL_ADDED
  LABEL_REMOVED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  SUBTASK_ADDED
  SUBTASK_COMPLETED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  SPRINT_ADDED
  SPRINT_REMOVED
  ARCHIVED
  RESTORED
  DELETED
  DEPENDENCY_ADDED
  DEPENDENCY_REMOVED
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  COMMENTED
  DUE_SOON
  OVERDUE
  SPRINT_STARTING
  SPRINT_ENDING
  TASK_MOVED
  TASK_UPDATED
  DEPENDENCY_BLOCKED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  URL
  EMAIL
}

enum AutomationTrigger {
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_COMPLETED
  TASK_OVERDUE
  SPRINT_STARTED
  SPRINT_ENDED
  COMMENT_ADDED
  MENTION_ADDED
}

enum AutomationAction {
  ASSIGN_USER
  CHANGE_PRIORITY
  CHANGE_STATUS
  ADD_LABEL
  REMOVE_LABEL
  SET_DUE_DATE
  ADD_TO_SPRINT
  REMOVE_FROM_SPRINT
  SEND_NOTIFICATION
  CREATE_TASK
  WEBHOOK
}

// ============================================================
// MODELS
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  emailVerified DateTime?
  image         String?
  theme         String    @default("system") // system, light, dark
  locale        String    @default("id-ID")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActiveAt  DateTime?

  accounts                Account[]
  sessions                Session[]
  workspaces              WorkspaceMember[]
  ownedWorkspaces         Workspace[]           @relation("WorkspaceOwner")
  assignedTasks           TaskAssignee[]
  createdTasks            Task[]                @relation("TaskCreator")
  updatedTasks            Task[]                @relation("TaskUpdater")
  comments                Comment[]
  activities              Activity[]
  notifications           Notification[]
  mentions                Mention[]
  notificationSettings    NotificationSetting[]
  timeEntries             TimeEntry[]
  createdAutomationRules  AutomationRule[]
  createdWebhooks         Webhook[]
  createdRecurringTasks   RecurringTask[]
  createdTaskTemplates    TaskTemplate[]
  createdProjectTemplates ProjectTemplate[]
  createdMilestones       Milestone[]
  templateUsages          TemplateUsage[]
  Invitation              Invitation[]
  ProjectMember           ProjectMember[]
  Attachment              Attachment[]
  SavedFilter             SavedFilter[]
  UserSettings            UserSettings?

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  logoUrl     String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members          WorkspaceMember[]
  projects         Project[]
  invitations      Invitation[]
  labels           Label[]
  sprints          Sprint[]
  customFields     CustomField[]
  automationRules  AutomationRule[]
  webhooks         Webhook[]
  taskTemplates    TaskTemplate[]
  projectTemplates ProjectTemplate[]
  savedFilters     SavedFilter[]

  @@index([ownerId])
  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  workspaceId String
  role        Role      @default(MEMBER)
  token       String    @unique @default(cuid())
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([token])
  @@index([email])
  @@map("invitations")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  key         String // Short key like "PROJ", "TIX"
  description String?  @db.Text
  color       String   @default("#3B82F6")
  icon        String   @default("folder")
  isArchived  Boolean  @default(false)
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members         ProjectMember[]
  columns         Column[]
  tasks           Task[]
  labels          Label[]
  sprints         Sprint[]
  customFields    CustomField[]
  automationRules AutomationRule[]
  webhooks        Webhook[]
  taskTemplates   TaskTemplate[]
  milestones      Milestone[]
  recurringTasks  RecurringTask[]
  SavedFilter     SavedFilter[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([isArchived])
  @@map("projects")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  position    Float // Fractional indexing within column
  priority    TaskPriority @default(MEDIUM)
  startDate   DateTime? // Start date for timeline/gantt view
  dueDate     DateTime?
  estimate    Int? // Story points or hours
  timeSpent   Int          @default(0) // Minutes
  isArchived  Boolean      @default(false)
  completedAt DateTime?
  projectId   String
  columnId    String
  creatorId   String
  updaterId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column               Column                 @relation(fields: [columnId], references: [id], onDelete: Cascade)
  creator              User                   @relation("TaskCreator", fields: [creatorId], references: [id])
  updater              User                   @relation("TaskUpdater", fields: [updaterId], references: [id])
  assignees            TaskAssignee[]
  labels               TaskLabel[]
  subtasks             Subtask[]
  comments             Comment[]
  attachments          Attachment[]
  activities           Activity[]
  mentions             Mention[]
  sprintTasks          SprintTask[]
  dependencies         TaskDependency[]       @relation("TaskDependencies")
  dependedBy           TaskDependency[]       @relation("DependedByTasks")
  customFieldValues    CustomFieldValue[]
  timeEntries          TimeEntry[]
  milestones           MilestoneTask[]
  RecurringTaskHistory RecurringTaskHistory[]

  @@index([projectId])
  @@index([columnId])
  @@index([position])
  @@index([priority])
  @@index([startDate])
  @@index([dueDate])
  @@index([isArchived])
  @@index([creatorId])
  @@index([updaterId])
  @@map("tasks")
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("project_members")
}

model Column {
  id        String     @id @default(cuid())
  name      String
  status    TaskStatus @unique
  position  Float // Fractional indexing
  wipLimit  Int?
  color     String     @default("#6B7280")
  projectId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([position])
  @@map("columns")
}

model Label {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#6B7280")
  workspaceId String?
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([name, workspaceId, projectId])
  @@index([workspaceId])
  @@index([projectId])
  @@map("labels")
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskLabel {
  id      String @id @default(cuid())
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
  @@map("task_labels")
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  position  Float
  taskId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([position])
  @@map("subtasks")
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  taskId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions Mention[]

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}

model Attachment {
  id           String   @id @default(cuid())
  name         String
  url          String
  mimeType     String
  size         Int
  taskId       String
  uploadedById String
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("attachments")
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  metadata  Json?
  taskId    String
  userId    String
  createdAt DateTime     @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

model Mention {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  taskId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([userId])
  @@index([taskId])
  @@map("mentions")
}

model Sprint {
  id          String   @id @default(cuid())
  name        String
  goal        String?  @db.Text
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  isCompleted Boolean  @default(false)
  workspaceId String
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks     SprintTask[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([isActive])
  @@map("sprints")
}

model SprintTask {
  id       String   @id @default(cuid())
  sprintId String
  taskId   String
  addedAt  DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sprintId, taskId])
  @@index([sprintId])
  @@index([taskId])
  @@map("sprint_tasks")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  userId    String
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model SavedFilter {
  id          String   @id @default(cuid())
  name        String
  filters     Json
  userId      String
  workspaceId String?
  projectId   String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([projectId])
  @@map("saved_filters")
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  emailNotifications   Boolean  @default(true)
  pushNotifications    Boolean  @default(true)
  desktopNotifications Boolean  @default(false)
  digestFrequency      String   @default("daily") // never, daily, weekly
  compactMode          Boolean  @default(false)
  sidebarCollapsed     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// Phase 6: Search & Advanced Features

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  type            String   @default("blocks") // blocks, is_blocked_by, relates_to
  createdAt       DateTime @default(now())

  task          Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("DependedByTasks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model CustomField {
  id          String          @id @default(cuid())
  name        String
  type        CustomFieldType
  options     Json? // For select/multi_select: array of {value, label, color?}
  description String?         @db.Text
  isRequired  Boolean         @default(false)
  position    Int             @default(0)
  projectId   String?
  workspaceId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project   Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@index([projectId])
  @@index([workspaceId])
  @@index([position])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String   @id @default(cuid())
  customFieldId String
  taskId        String
  value         Json // Stores value based on field type
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, taskId])
  @@index([taskId])
  @@map("custom_field_values")
}

model AutomationRule {
  id          String            @id @default(cuid())
  name        String
  description String?           @db.Text
  trigger     AutomationTrigger
  conditions  Json // Array of conditions
  actions     Json // Array of actions
  enabled     Boolean           @default(true)
  projectId   String?
  workspaceId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdById String

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id])

  @@index([projectId])
  @@index([workspaceId])
  @@index([enabled])
  @@map("automation_rules")
}

model Webhook {
  id          String   @id @default(cuid())
  name        String
  url         String
  secret      String?
  events      String[] // Array of event names
  enabled     Boolean  @default(true)
  projectId   String?
  workspaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id])

  @@index([projectId])
  @@index([workspaceId])
  @@index([enabled])
  @@map("webhooks")
}

// Phase 7: Notifications & Real-time

model NotificationSetting {
  id        String   @id @default(cuid())
  userId    String
  channel   String // email, push, in_app
  eventType String // e.g., ASSIGNED, MENTIONED, DUE_SOON
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, eventType])
  @@index([userId])
  @@map("notification_settings")
}

// Phase 8: Advanced Project Features

model TimeEntry {
  id          String    @id @default(cuid())
  taskId      String
  userId      String
  duration    Int // Minutes
  description String?   @db.Text
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([startedAt])
  @@map("time_entries")
}

model RecurringTask {
  id             String   @id @default(cuid())
  name           String
  templateData   Json // Full task template
  frequency      String // daily, weekly, monthly, custom
  interval       Int      @default(1) // Every N periods
  daysOfWeek     Int[]    @default([]) // For weekly: [0,1,2,3,4,5,6] (0=Sunday)
  dayOfMonth     Int? // For monthly: 1-31
  nextOccurrence DateTime
  isActive       Boolean  @default(true)
  projectId      String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy            User                   @relation(fields: [createdById], references: [id])
  RecurringTaskHistory RecurringTaskHistory[]

  @@index([projectId])
  @@index([nextOccurrence])
  @@index([isActive])
  @@map("recurring_tasks")
}

model TaskTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  templateData Json // Complete task data
  projectId    String?
  workspaceId  String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id])

  @@index([projectId])
  @@index([workspaceId])
  @@index([isPublic])
  @@map("task_templates")
}

model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  columns     Json // Array of column templates
  labels      Json? // Array of label templates
  isPublic    Boolean  @default(false)
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([workspaceId])
  @@index([isPublic])
  @@map("project_templates")
}

model Milestone {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  dueDate     DateTime
  completedAt DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User            @relation(fields: [createdById], references: [id])
  tasks     MilestoneTask[]

  @@index([projectId])
  @@index([dueDate])
  @@map("milestones")
}

model MilestoneTask {
  id          String   @id @default(cuid())
  milestoneId String
  taskId      String
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, taskId])
  @@index([milestoneId])
  @@index([taskId])
  @@map("milestone_tasks")
}

model RecurringTaskHistory {
  id              String   @id @default(cuid())
  recurringTaskId String
  taskId          String
  createdAt       DateTime @default(now())

  recurringTask RecurringTask @relation(fields: [recurringTaskId], references: [id], onDelete: Cascade)
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([recurringTaskId])
  @@index([taskId])
  @@index([createdAt])
  @@map("recurring_task_history")
}

model TemplateUsage {
  id           String   @id @default(cuid())
  templateId   String
  templateType String // "task" | "project"
  userId       String
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id])

  @@index([templateId])
  @@index([templateType])
  @@index([userId])
  @@index([createdAt])
  @@map("template_usages")
}
